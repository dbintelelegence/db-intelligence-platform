# Database — local Postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/db_intelligence

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Anthropic — used ONLY to generate plain-English explanations on status change
# Never used to diagnose issues — that is always deterministic
ANTHROPIC_API_KEY=

# Analyzer thresholds (defaults are sensible — only override for tuning)
# DEGRADED_SIGMA_THRESHOLD=2.0
# CRITICAL_SIGMA_THRESHOLD=3.5
# BASELINE_MIN_SAMPLES=100
# BASELINE_LOOKBACK_DAYS=30
